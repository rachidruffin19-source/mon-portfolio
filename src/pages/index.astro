---
import Layout from '../layouts/Layout.astro';
import SectionDivider from '../components/SectionDivider.astro';
import { SOCIAL } from '../data/social';
import { PROJECTS } from '../data/projects';
import { EXPERIENCES, EDUCATION } from '../data/experience';
---

<Layout title="Rachid Ruffin | Développeur Fullstack">
  <article class="relative z-10 max-w-4xl mx-auto px-6 pt-32 pb-20">

    <!-- ═══════════════════════════════════════════════
         HERO
    ════════════════════════════════════════════════ -->
    <section
      id="hero"
      class="min-h-[70vh] flex flex-col justify-center text-center mb-20 reveal-on-scroll"
      aria-labelledby="hero-title"
    >
      <div id="hero-title" class="sr-only">Développeur Fullstack — Rachid Ruffin</div>

      <div
        class="inline-block mb-6 px-4 py-1 rounded-full glass-card text-sm text-cyan-400 tracking-wide mx-auto"
      >
        ✦ Ouvert aux opportunités
      </div>

      <h1 class="text-6xl font-bold mb-6 leading-tight">Rachid Ruffin</h1>

      <p class="text-2xl font-light text-violet-300 mb-4">
        <span id="typewriter"></span><span class="typewriter-cursor">|</span>
      </p>

      <p class="text-lg text-slate-400 mb-10 max-w-2xl mx-auto leading-relaxed">
        Je conçois des applications web modernes — du front au back. Passionné par la technologie,
        je construis des produits réels avec une stack <strong class="text-slate-200">full JavaScript</strong>,
        du <strong class="text-slate-200">Python</strong> et de l'<strong class="text-slate-200">IA</strong>.
      </p>

      <div class="flex gap-4 justify-center flex-wrap">
        <a href="#projets" class="btn-primary px-8 py-3 rounded-xl font-semibold text-white">
          Voir mes projets →
        </a>
        <a href="#contact" class="btn-outlined px-8 py-3 rounded-xl font-semibold text-slate-300">
          Me contacter
        </a>
      </div>

      <div class="scroll-indicator mt-16 mx-auto" aria-hidden="true">
        <span></span>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════
         À PROPOS
    ════════════════════════════════════════════════ -->
    <section id="about" class="mb-28 reveal-on-scroll" aria-labelledby="about-heading">
      <SectionDivider />

      <h2 id="about-heading" class="text-3xl font-bold mb-8">
        Qui suis-<span class="neon-text">je</span> ?
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="glass-card p-6 md:col-span-2">
          <p class="text-slate-300 leading-relaxed mb-4">
            Développeur Fullstack passionné, étudiant et entrepreneur. Je vis dans le code —
            j'aime autant concevoir des interfaces soignées qu'architecturer des systèmes backend
            robustes. À l'ère de l'IA, je m'adapte, j'intègre, je construis.
          </p>
          <p class="text-slate-400 leading-relaxed">
            Mon moteur : la soif de nouvelles connaissances. Chaque projet est une opportunité
            d'apprendre une techno, de résoudre un vrai problème. Je ne théorise pas — je livre.
          </p>
        </div>

        <div class="flex flex-col gap-4">
          <div class="glass-card p-5 text-center">
            <div class="text-3xl font-bold neon-text mb-1">4+</div>
            <div class="text-xs text-slate-500 uppercase tracking-widest">Projets</div>
          </div>
          <div class="glass-card p-5 text-center">
            <div class="text-3xl font-bold neon-text mb-1">Full</div>
            <div class="text-xs text-slate-500 uppercase tracking-widest">JS Stack</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════
         COMPÉTENCES
    ════════════════════════════════════════════════ -->
    <section class="mb-28 reveal-on-scroll" aria-labelledby="skills-heading">
      <SectionDivider />

      <h2 id="skills-heading" class="text-3xl font-bold mb-8">
        Mes <span class="neon-text">Compétences</span>
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <!-- Frontend -->
        <div class="glass-card p-5">
          <h3 class="text-sm font-semibold mb-4 text-cyan-400 uppercase tracking-widest">Frontend</h3>
          <ul class="space-y-2 text-slate-300 text-sm">
            <li>HTML5 / CSS3</li>
            <li>JavaScript (ES6+)</li>
            <li>React</li>
            <li>EJS</li>
            <li>Astro</li>
            <li>Tailwind CSS</li>
            <li>SCSS</li>
          </ul>
        </div>

        <!-- Backend -->
        <div class="glass-card p-5">
          <h3 class="text-sm font-semibold mb-4 text-violet-400 uppercase tracking-widest">Backend</h3>
          <ul class="space-y-2 text-slate-300 text-sm">
            <li>Node.js</li>
            <li>Express</li>
            <li>PHP</li>
            <li>Python</li>
            <li>C++</li>
            <li>REST APIs</li>
          </ul>
        </div>

        <!-- Data & DevOps -->
        <div class="glass-card p-5">
          <h3 class="text-sm font-semibold mb-4 text-pink-400 uppercase tracking-widest">Data & Ops</h3>
          <ul class="space-y-2 text-slate-300 text-sm">
            <li>MongoDB</li>
            <li>SQL / MySQL</li>
            <li>Docker</li>
            <li>Datadog</li>
            <li>SLSA</li>
          </ul>
        </div>

        <!-- IA & Tools -->
        <div class="glass-card p-5">
          <h3 class="text-sm font-semibold mb-4 text-emerald-400 uppercase tracking-widest">IA & Tools</h3>
          <ul class="space-y-2 text-slate-300 text-sm">
            <li>Groq / Llama 3</li>
            <li>TypeScript</li>
            <li>Git / GitHub</li>
            <li>Vercel / Render</li>
            <li>Telegram Bot API</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════
         PROJETS
    ════════════════════════════════════════════════ -->
    <section id="projets" class="mb-28 reveal-on-scroll" aria-labelledby="projects-heading">
      <SectionDivider />

      <h2 id="projects-heading" class="text-3xl font-bold mb-8">
        Mes <span class="neon-text">Projets</span>
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {PROJECTS.map((project) => (
          <div class={`glass-card p-6 flex flex-col ${!project.featured ? 'opacity-80' : ''}`}>
            <div class="flex items-start justify-between mb-3">
              <h3 class="text-xl font-bold text-violet-300">{project.title}</h3>
              <span class={`text-xs px-2 py-1 rounded-full ml-2 flex-shrink-0 ${
                project.visibility === 'public'
                  ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20'
                  : 'bg-slate-500/10 text-slate-500 border border-slate-500/20'
              }`}>
                {project.visibility === 'public' ? '● Public' : '○ Privé'}
              </span>
            </div>

            <p class="text-slate-400 mb-4 leading-relaxed text-sm flex-1">
              {project.description}
            </p>

            <div class="flex gap-2 flex-wrap mb-4">
              {project.tech.map((t) => (
                <span class="tech-tag">{t}</span>
              ))}
            </div>

            <div class="flex gap-3 flex-wrap mt-auto">
              {project.github && (
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="project-link"
                >
                  GitHub →
                </a>
              )}
              {project.demo && (
                <a
                  href={project.demo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="project-link"
                  style="color: #22d3ee"
                >
                  Demo →
                </a>
              )}
              {!project.github && !project.demo && (
                <span class="text-xs text-slate-600 italic">Accès privé</span>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════
         TIMELINE
    ════════════════════════════════════════════════ -->
    <section id="timeline" class="mb-28 reveal-on-scroll" aria-labelledby="timeline-heading">
      <SectionDivider />

      <h2 id="timeline-heading" class="text-3xl font-bold mb-12">
        Mon <span class="neon-text">Parcours</span>
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">

        <!-- Expériences -->
        <div>
          <h3 class="text-lg font-semibold text-cyan-400 mb-6 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-cyan-400 inline-block"></span>
            Expériences
          </h3>
          <div class="timeline-column">
            {EXPERIENCES.map((item) => (
              <div class="timeline-item">
                <div class="timeline-dot" data-type={item.type}></div>
                <div class="timeline-content glass-card p-4">
                  <div class="flex items-start justify-between gap-2 mb-1">
                    <span class="font-semibold text-slate-200 text-sm">{item.title}</span>
                    {item.current && (
                      <span class="text-xs px-2 py-0.5 rounded-full bg-violet-500/15 text-violet-400 border border-violet-500/20 flex-shrink-0">
                        En cours
                      </span>
                    )}
                  </div>
                  <div class="text-xs text-violet-400 mb-1">{item.organization}</div>
                  <div class="text-xs text-slate-600 mb-2">{item.period}</div>
                  <p class="text-xs text-slate-400 leading-relaxed">{item.description}</p>
                  {item.tech && (
                    <div class="flex gap-1 flex-wrap mt-3">
                      {item.tech.map((t) => (
                        <span class="tech-tag" style="font-size:0.6rem;padding:0.1rem 0.5rem">{t}</span>
                      ))}
                    </div>
                  )}
                  {item.link && (
                    <a
                      href={item.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="project-link mt-2 inline-block"
                      style="font-size:0.75rem"
                    >
                      Voir →
                    </a>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Formation -->
        <div>
          <h3 class="text-lg font-semibold text-violet-400 mb-6 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-violet-400 inline-block"></span>
            Formation
          </h3>
          <div class="timeline-column">
            {EDUCATION.map((item) => (
              <div class="timeline-item">
                <div class="timeline-dot education"></div>
                <div class="timeline-content glass-card p-4">
                  <div class="flex items-start justify-between gap-2 mb-1">
                    <span class="font-semibold text-slate-200 text-sm">{item.title}</span>
                    {item.current && (
                      <span class="text-xs px-2 py-0.5 rounded-full bg-violet-500/15 text-violet-400 border border-violet-500/20 flex-shrink-0">
                        En cours
                      </span>
                    )}
                  </div>
                  <div class="text-xs text-violet-400 mb-1">{item.organization}</div>
                  <div class="text-xs text-slate-600 mb-2">{item.period}</div>
                  <p class="text-xs text-slate-400 leading-relaxed">{item.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

      </div>
    </section>

    <!-- ═══════════════════════════════════════════════
         CONTACT
    ════════════════════════════════════════════════ -->
    <section id="contact" class="reveal-on-scroll" aria-labelledby="contact-heading">
      <SectionDivider />

      <h2 id="contact-heading" class="text-3xl font-bold mb-8">
        Me <span class="neon-text">Contacter</span>
      </h2>

      <div class="glass-card p-8">
        <p class="text-slate-400 mb-8 text-lg leading-relaxed">
          Tu as un projet à développer ou une opportunité à partager ?<br />
          Je suis disponible et ouvert à tout.
        </p>
        <div class="contact-links">
          <a href={`mailto:${SOCIAL.email}`} class="contact-btn contact-btn-email">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 8.5v7a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
              <path d="M21 8.5l-9 6-9-6"></path>
            </svg>
            {SOCIAL.email}
          </a>

          <a href={SOCIAL.github} target="_blank" rel="noopener noreferrer"
            class="contact-btn contact-btn-github">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path>
            </svg>
            {SOCIAL.github.replace('https://', '')}
          </a>

          <a href={SOCIAL.linkedIn} target="_blank" rel="noopener noreferrer"
            class="contact-btn contact-btn-linkedin">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path>
            </svg>
            {SOCIAL.linkedIn.replace('https://', '')}
          </a>
        </div>
      </div>
    </section>
  </article>

  <!-- FOOTER -->
  <footer class="footer-main" role="contentinfo">
    <div class="footer-content">
      <span class="footer-logo">
        <span class="logo-name">RachidRuffin</span><span class="logo-tld">.dev</span>
      </span>
      <span class="footer-sep">·</span>
      <span class="footer-credit">Fait avec <a href="https://astro.build" target="_blank"
          rel="noopener noreferrer" class="footer-link">Astro</a> & ☕</span>
      <span class="footer-sep">·</span>
      <span class="footer-copy">© <span id="copyright-year"></span></span>
      <span class="footer-sep">·</span>
      <a href="#hero" class="footer-top" aria-label="Retour en haut">↑ Haut</a>
    </div>
  </footer>

  <script>
    import { initTypewriter } from '../scripts/typewriter';
    initTypewriter('#typewriter', [
      'Développeur Fullstack',
      'Full JavaScript Stack',
      'Builder — Entrepreneur',
      'IA & Web — Madagascar 🇲🇬',
    ]);
    const yearEl = document.getElementById('copyright-year');
    if (yearEl) yearEl.textContent = String(new Date().getFullYear());
  </script>
</Layout>